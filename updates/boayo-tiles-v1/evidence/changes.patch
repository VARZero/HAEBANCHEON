+      for(auto i=dirty.begin();i!=dirty.end();){unsigned first=*i,last=first;
+        if(output.shadow[256+first]==0xffffffffu){++i;continue;}++i;
+        while(i!=dirty.end() && *i==last+1 && output.shadow[256+*i]!=0xffffffffu){last=*i;++i;}
