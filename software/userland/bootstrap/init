#!/bin/busybox sh
export PATH=/bin
bb=/bin/busybox
repair() {
    echo "HAEBANCHEON: $*; entering recovery shell (rootfs was not formatted)"
    while :; do
        $bb setsid $bb cttyhack $bb sh
        $bb sleep 1
    done
}
$bb mount -t proc proc /proc
$bb mount -t sysfs sysfs /sys
$bb mount -t devtmpfs devtmpfs /dev
root=/dev/mmcblk0p2
for arg in $($bb cat /proc/cmdline); do
    case "$arg" in
        haebancheon.root=*) root=${arg#*=};;
        haebancheon.recovery=1) repair 'recovery requested';;
    esac
done
case "$root" in /dev/*) ;; *) repair 'invalid root device';; esac
n=0
while [ ! -b "$root" ] && [ "$n" -lt 20 ]; do
    $bb sleep 1
    n=$((n+1))
done
$bb mount -t ext4 -o rw,noatime "$root" /newroot || repair "cannot mount $root"
[ -x /newroot/sbin/init ] || repair 'rootfs has no /sbin/init'
for dir in dev proc sys; do
    $bb mkdir -p "/newroot/$dir"
    $bb mount --move "/$dir" "/newroot/$dir" || repair "cannot move $dir"
done
echo "HAEBANCHEON: switching to $root"
exec $bb switch_root /newroot /sbin/init
